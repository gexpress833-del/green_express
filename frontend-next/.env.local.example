# En local : même origine que Next (rewrites vers Laravel) pour que le jeton CSRF soit lisible en JS.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Cible du proxy (php artisan serve) — utilisé par next.config.js rewrites uniquement.
API_PROXY_TARGET=http://localhost:8000
# Optionnel : si vous changez SESSION_COOKIE dans Laravel, aligner le middleware Next :
# NEXT_PUBLIC_SESSION_COOKIE_NAME=green-express-session

# Production (API sur Render) :
# NEXT_PUBLIC_API_URL=https://greenexpress-administration.onrender.com
# API_PROXY_TARGET=https://greenexpress-administration.onrender.com

# NextAuth (Google OAuth — callback sur le front Vercel / localhost:3000)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=  # openssl rand -base64 32
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=GOCSPX-...   # « Code secret du client » — jamais le Client ID

# Laravel (Render) : même GOOGLE_CLIENT_ID pour vérifier l’aud du id_token
# GOOGLE_CLIENT_ID=

# Firebase Cloud Messaging (push notifications navigateur) — valeurs publiques.
# Récupérables sur https://console.firebase.google.com/project/<project>/settings/general
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project>
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# VAPID key Web Push — onglet « Cloud Messaging » → « Certificats Web push »
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
